# Copy this file to .env (same folder) and fill in the values after the = signs.
# .env is private: it is git-ignored. Never put it on a shared USB stick or in the paper.

# Which model writes the answers: llama (Colab) or openai (gpt-4o-mini backup)
POC_GENERATOR=llama

# --- llama: printed by colab/llama_server.ipynb. The URL changes every Colab session.
LLAMA_BASE_URL=
LLAMA_API_KEY=

# --- openai: only needed when POC_GENERATOR=openai
OPENAI_API_KEY=
# POC_OPENAI_MODEL=gpt-4o-mini
